          },
          "sub_sport": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sub Sport"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "start_utc": {
            "type": "string",
