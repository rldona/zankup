{
  "name": "@opensport/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Shared TypeScript for the PWA and the Android app: API client, formatting, domain, design tokens and i18n catalogues",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate:types": "openapi-typescript src/api/openapi.json -o src/api/schema.ts && prettier --write src/api/schema.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
