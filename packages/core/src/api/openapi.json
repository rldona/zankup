{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenSport API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness and database check, used by Railway on deploy and by the PWA through the Vercel proxy.\n\nAlways 200: a database outage is reported as `degraded`, so the API itself stays observable.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "description": "degraded when the database is unreachable"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database"
          },
          "schema_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Revision",
            "description": "Alembic revision applied to the database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "database",
          "schema_revision"
        ],
        "title": "Health"
      }
    }
  }
}
