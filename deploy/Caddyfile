# One origin for the PWA and the API (OS-224). ZANKUP_SITE is the address Caddy serves:
#   your.domain.com  → automatic HTTPS with Let's Encrypt (ports 80 and 443 open)
#   :8080            → plain HTTP, for a first try on your own machine
{$ZANKUP_SITE::8080} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Hashed file names never change: cache them for a year. The service worker and the page must
		# always be fresh, so a new version is picked up at once.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@fresh path /sw.js /registerSW.js /index.html /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
