# Copy to .env (`make setup` does it) and fill in what you need. .env is ignored by git.
# Production values live only in Railway's and Vercel's variables. See docs/self-hosting.md (OS-224).

# --- Required ---------------------------------------------------------------
# Garmin Connect Personal API key: https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=

# --- Runtime ------------------------------------------------------------------
# development | test | production (Railway sets production). Logs are JSON in production.
ENVIRONMENT=development
LOG_LEVEL=INFO
# json | console (default: json in production, console otherwise)
LOG_FORMAT=

# --- Backend (local defaults; docker compose overrides DATABASE_URL and DATA_DIR for the api container) ---
DATABASE_URL=postgresql://opensport:opensport@127.0.0.1:5432/opensport
DATA_DIR=./data
# Owner account used by the sync until sign-up exists (OS-221)
OWNER_EMAIL=owner@opensport.local
# Run the background job worker (and the sync schedule) inside the API process
RUN_WORKER=true
# Automatic Garmin sync every N minutes; 0 turns it off
SYNC_INTERVAL_MINUTES=15
# Signs sessions. Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Optional integrations (features stay hidden without them) --------------
# Transactional email (password recovery, OS-222): https://resend.com/api-keys
RESEND_API_KEY=
# Google sign-in (OS-220): OAuth web client from Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AI features (phase 7): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Only for setting up infrastructure from the command line ---------------
RAILWAY_API_TOKEN=
VERCEL_TOKEN=
