# Copy to .env (`make setup` does it) and fill in what you need. .env is ignored by git.
# Production values live only in Railway's and Vercel's variables. See docs/self-hosting.md (OS-224).

# --- Required ---------------------------------------------------------------
# Garmin Connect Personal API key: https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=
# Optional: the date your Garmin key expires (YYYY-MM-DD), shown in Settings and warned two weeks before.
GARMIN_KEY_EXPIRES_ON=

# --- Runtime ------------------------------------------------------------------
# development | test | production (Railway sets production). Logs are JSON in production.
ENVIRONMENT=development
LOG_LEVEL=INFO
# json | console (default: json in production, console otherwise)
LOG_FORMAT=

# --- Backend (local defaults; docker compose overrides DATABASE_URL and DATA_DIR for the api container) ---
DATABASE_URL=postgresql://zankup:zankup@127.0.0.1:5432/zankup
DATA_DIR=./data
# Owner account used by the sync until sign-up exists (OS-221)
OWNER_EMAIL=owner@zankup.local
# Run the background job worker (and the sync schedule) inside the API process
RUN_WORKER=true
# Automatic Garmin sync every N minutes; 0 turns it off
SYNC_INTERVAL_MINUTES=15
# Signs sessions. Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Optional integrations (features stay hidden without them) --------------
# E-mail (sync failure alerts OS-114, password recovery OS-222): https://resend.com/api-keys
RESEND_API_KEY=
# Where alerts go. With Resend's test sender (the default ALERT_FROM) this must be the address of
# your Resend account; with a verified domain, set ALERT_FROM="Zankup <alerts@your-domain>".
ALERT_EMAIL=
# ALERT_FROM=

# Daily backups (OS-114) of the database and the original FIT files, to any S3-compatible bucket
# (Railway bucket, Cloudflare R2, Backblaze B2…) or to a local directory (BACKUP_DIR). Off without them.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_DIR=/mnt/backups
# BACKUP_KEEP_DAYS=30
# BACKUP_HOUR_UTC=3
# pg_dump/pg_restore of the server's major version (the Docker image has them). Locally, through the
# compose container: PG_DUMP_COMMAND="docker exec -i zankup-db-1 pg_dump" (same for PG_RESTORE_COMMAND)
# Passkeys (OS-405): the domain they are bound to and the PWA's origins. Never change the RP ID once
# passkeys exist: every one of them stops working. Production: zankup.com and ["https://zankup.com"].
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=["http://localhost:5173","http://localhost:8000"]
# Google sign-in (OS-220): your own OAuth web client from Google Cloud. Its redirect URI is the first
# of WEBAUTHN_ORIGINS + /api/auth/google/callback. Without them, the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AI features (phase 7): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Self-hosting with deploy/compose.yaml (docs/self-hosting.md) -----------
# The database password, and the address Caddy serves: your domain (automatic HTTPS) or :8080 to try it.
POSTGRES_PASSWORD=
ZANKUP_SITE=:8080

# --- Only for setting up infrastructure from the command line ---------------
RAILWAY_API_TOKEN=
VERCEL_TOKEN=
